# AEGIS Environment Variables

# Modbus Configuration
MODBUS_IP=192.168.1.100
MODBUS_PORT=502
MODBUS_SLAVE_ID=1

# Serial Configuration (optional, for auxiliary sensors)
SERIAL_PORT=COM3
SERIAL_BAUDRATE=115200

# Model Paths
MODEL_POSE_PATH=models/custom/grab_pose.engine
MODEL_DETECT_PATH=models/pretrained/yolov8n.pt

# Performance Settings
TARGET_LATENCY_MS=500
FPS_TARGET=30

# Dashboard Settings
DASHBOARD_PORT=8501
DASHBOARD_DEBUG=false

# Logging
LOG_LEVEL=INFO
LOG_OUTPUT_DIR=logs

# Development
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
